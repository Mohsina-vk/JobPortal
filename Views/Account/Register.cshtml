@model JobPortal.Models.ViewModels.RegisterViewModel
@{
  ViewData["Title"] = "Create Account";
}

<section class="section">
  <div class="container">
    <div style="max-width:520px;margin:0 auto">
      <div class="text-center mb-3">
        <div style="font-size:2.5rem;margin-bottom:8px">👋</div>
        <h1 style="font-size:1.8rem;font-weight:800">Create Your Account</h1>
        <p style="color:var(--text-secondary);margin-top:6px">Join thousands of professionals on JobPortal</p>
      </div>

      <div class="card">
        <form asp-action="Register" method="post">
          @Html.AntiForgeryToken()
          <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>

          <!-- Role Selector -->
          <div class="form-group">
            <label class="form-label">I am a...</label>
            <div class="role-selector">
              <label class="role-option">
                <input type="radio" name="Role" value="0" checked />
                <div class="role-option-label">
                  <span class="icon">👤</span>
                  <span class="title">Job Seeker</span>
                  <span class="desc">Looking for opportunities</span>
                </div>
              </label>
              <label class="role-option">
                <input type="radio" name="Role" value="1" />
                <div class="role-option-label">
                  <span class="icon">🏢</span>
                  <span class="title">Recruiter</span>
                  <span class="desc">Hiring talent</span>
                </div>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label asp-for="FullName" class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" placeholder="John Smith" />
            <span asp-validation-for="FullName" class="field-validation-error"></span>
          </div>

          <div class="form-group">
            <label asp-for="Email" class="form-label">Email Address</label>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" type="email" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
          </div>

          <div id="company-field" class="form-group" style="display:none">
            <label asp-for="CompanyName" class="form-label">Company Name</label>
            <input asp-for="CompanyName" class="form-control" placeholder="Your Company Ltd." />
            <span asp-validation-for="CompanyName" class="field-validation-error"></span>
          </div>

          <div class="form-group">
            <label asp-for="Location" class="form-label">Location <span style="color:var(--text-muted)">(optional)</span></label>
            <input asp-for="Location" class="form-control" placeholder="City, Country" />
          </div>

          <div class="form-group">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" type="password" placeholder="Min. 6 characters" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
          </div>

          <div class="form-group">
            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Repeat password" />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
          </div>

          <button type="submit" class="btn btn-primary w-100" style="margin-top:8px">
            Create Account →
          </button>
        </form>

        <div class="divider"></div>
        <p class="text-center text-sm" style="color:var(--text-muted)">
          Already have an account?
          <a asp-controller="Account" asp-action="Login">Sign in here</a>
        </p>
      </div>
    </div>
  </div>
</section>

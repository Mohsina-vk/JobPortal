@model JobPortal.Models.ViewModels.PostJobViewModel
@using JobPortal.Models
@{
  var isEdit = Model.Id.HasValue;
  ViewData["Title"] = isEdit ? "Edit Job" : "Post a Job";
}

<section class="section">
  <div class="container">
    <div style="max-width:800px;margin:0 auto">
      <div class="page-header">
        <h1>@(isEdit ? "✏️ Edit Job" : "📢 Post a New Job")</h1>
        <p>@(isEdit ? "Update the job details below" : "Reach thousands of qualified candidates")</p>
      </div>

      <div class="card">
        <form asp-action="@(isEdit ? "EditJob" : "PostJob")" method="post">
          @Html.AntiForgeryToken()
          @if (isEdit)
          {
            <input type="hidden" asp-for="Id" />
          }
          <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem">
            <div class="form-group" style="grid-column:1/-1">
              <label asp-for="Title" class="form-label">Job Title *</label>
              <input asp-for="Title" class="form-control" placeholder="e.g. Senior .NET Developer" />
              <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>

            <div class="form-group">
              <label asp-for="CompanyName" class="form-label">Company Name *</label>
              <input asp-for="CompanyName" class="form-control" placeholder="Your Company" />
              <span asp-validation-for="CompanyName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
              <label asp-for="Location" class="form-label">Location *</label>
              <input asp-for="Location" class="form-control" placeholder="City, State or Remote" />
              <span asp-validation-for="Location" class="field-validation-error"></span>
            </div>

            <div class="form-group">
              <label asp-for="JobType" class="form-label">Job Type *</label>
              <select asp-for="JobType" class="form-control">
                @foreach (var jt in Enum.GetValues<JobType>())
                {
                  <option value="@((int)jt)">@jt</option>
                }
              </select>
              <span asp-validation-for="JobType" class="field-validation-error"></span>
            </div>

            <div class="form-group">
              <label asp-for="Category" class="form-label">Category *</label>
              <select asp-for="Category" class="form-control">
                @foreach (var cat in Enum.GetValues<JobCategory>())
                {
                  <option value="@((int)cat)">@cat</option>
                }
              </select>
              <span asp-validation-for="Category" class="field-validation-error"></span>
            </div>

            <div class="form-group">
              <label asp-for="SalaryRange" class="form-label">Salary Range</label>
              <input asp-for="SalaryRange" class="form-control" placeholder="e.g. $80,000 - $120,000" />
            </div>

            <div class="form-group">
              <label asp-for="ExperienceYears" class="form-label">Experience Required (years)</label>
              <input asp-for="ExperienceYears" class="form-control" type="number" min="0" max="30" placeholder="0" />
            </div>

            <div class="form-group" style="grid-column:1/-1">
              <label asp-for="RequiredSkills" class="form-label">Required Skills</label>
              <input asp-for="RequiredSkills" class="form-control" placeholder="C#, ASP.NET, SQL Server, React (comma separated)" />
            </div>

            <div class="form-group" style="grid-column:1/-1">
              <label asp-for="Description" class="form-label">Job Description *</label>
              <textarea asp-for="Description" class="form-control" style="min-height:240px"
                placeholder="Describe the role, responsibilities, requirements..."></textarea>
              <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <div class="form-group" style="grid-column:1/-1">
              <label asp-for="Benefits" class="form-label">Benefits</label>
              <input asp-for="Benefits" class="form-control" placeholder="Health Insurance, Remote Work, Stock Options..." />
            </div>

            <div class="form-group">
              <label asp-for="Deadline" class="form-label">Application Deadline</label>
              <input asp-for="Deadline" class="form-control" type="date" />
            </div>

            <div class="form-group" style="display:flex;align-items:center;gap:10px;padding-top:24px">
              <label class="form-check">
                <input asp-for="IsActive" type="checkbox" />
                <span style="font-size:0.9rem;font-weight:600">Publish immediately (Active)</span>
              </label>
            </div>
          </div>

          <div class="divider"></div>

          <div class="flex-between">
            <a asp-controller="Recruiter" asp-action="MyJobs" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-primary btn-lg">
              @(isEdit ? "Save Changes ✓" : "Post Job 🚀")
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
